# =============================================================================
# UrbanGraph-SG Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- LLM Provider (DeepSeek via Cherry Studio or direct API) ---
# For Cherry Studio: use the local proxy URL
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-chat

# Alternative: OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Alternative: Ollama (local, free)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# --- Singapore Government APIs ---
# LTA DataMall: register at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=your-lta-account-key

# OneMap API: register at https://www.onemap.gov.sg/apidocs/register
ONEMAP_API_TOKEN=your-onemap-api-token

# data.gov.sg APIs generally do not require authentication

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=urbangraph-sg-dev
# For Docker Compose, use:
# NEO4J_URI=bolt://neo4j:7687

# --- Project Settings ---
LOG_LEVEL=INFO
DATA_DIR=./data
SINGAPORE_TIMEZONE=Asia/Singapore

# --- Data Range ---
DATA_START_YEAR=2024
DATA_END_YEAR=2025
