# UrbanGraph-SG — Streamlit Secrets (local development only)
# For Cloud: paste this into Streamlit Cloud dashboard > Settings > Secrets

LLM_BASE_URL = "https://api.deepseek.com"
LLM_API_KEY = "sk-your-deepseek-key"
LLM_MODEL = "deepseek-chat"

LTA_ACCOUNT_KEY = "your-lta-account-key"

ONEMAP_API_TOKEN = "your-onemap-token"

NEO4J_URI = "bolt://localhost:7687"
NEO4J_USER = "neo4j"
NEO4J_PASSWORD = "neo4j"

LOG_LEVEL = "INFO"
DATA_DIR = "./data"
DATA_START_YEAR = "2025"
DATA_END_YEAR = "2026"
